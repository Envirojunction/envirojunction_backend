            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"title\": \"Senior Environmental Consultant\",\n  \"headline\": \"Sustainability & Environmental Impact Assessment Specialist\",\n  \"about\": \"Experienced environmental specialist with 8+ years leading ESG initiatives and compliance auditing.\",\n  \"skills\": \"EIA, ISO 14001, Carbon Accounting, ESG Reporting\",\n  \"professional_skills\": [\n    \"Environmental Impact Assessment\",\n    \"Carbon Footprint Analysis\",\n    \"Life Cycle Assessment\",\n    \"ISO 14001 Auditing\"\n  ],\n  \"services\": [\n    \"ESG Consulting\",\n    \"Environmental Audit\",\n    \"Regulatory Compliance\"\n  ],\n  \"education\": [\n    {\n      \"title\": \"M.Sc. Environmental Science\",\n      \"name\": \"Stanford University\",\n      \"start_year\": 2016,\n      \"end_year\": 2018\n    }\n  ],\n  \"certifications\": [\n    {\n      \"title\": \"Lead Auditor ISO 14001\",\n      \"name\": \"IRCA\",\n      \"start_year\": 2019,\n      \"end_year\": 2022\n    }\n  ],\n  \"work_experience\": [\n    {\n      \"title\": \"Lead Environmental Consultant\",\n      \"name\": \"EcoGlobal Solutions\",\n      \"start_year\": 2020,\n      \"end_year\": 2024,\n      \"about\": \"Managed client carbon footprint reduction programs across APAC.\",\n      \"isPresent\": true\n    }\n  ],\n  \"location\": \"San Francisco, CA, USA\",\n  \"sectors\": [\n    \"Renewable Energy\",\n    \"Waste Management\",\n    \"Water Resources\"\n  ],\n  \"phone\": \"+14155552671\",\n  \"languages\": [\n    \"English\",\n    \"Spanish\"\n  ],\n  \"projects\": [\n    {\n      \"name\": \"Solar Farm Ecological Assessment\",\n      \"tags\": [\n        \"Solar\",\n        \"Biodiversity\",\n        \"EIA\"\n      ],\n      \"title\": \"Lead Assessor\",\n      \"projectType\": \"Renewable Infrastructure\",\n      \"date\": \"2023-08-15T00:00:00.000Z\",\n      \"details\": \"Conducted multi-seasonal biodiversity surveys and habitat mitigation plans for 200MW solar plant.\",\n      \"status\": \"Completed\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "profile"]
            },
            "description": "Updates profile details for the given user ID. (Requires JWT auth)."
          },
          "response": []
        }
